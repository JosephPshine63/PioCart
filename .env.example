# Copy to .env (gitignored) and fill in.
# Locally Spring Boot imports it on startup; on the server docker compose reads it (`docker compose --profile app up -d --build`).

# Stripe secret key from the dashboard in test mode: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...

# --- Server only (leave them commented out for local development) ---
# HMAC key for JWTs, base64, at least 256 bits: openssl rand -base64 48
#JWT_SECRET=
# Database password, used by both the Postgres and the app containers (applied only when the volume is first created)
#DB_PASSWORD=
# Public URL of the storefront on Vercel: Stripe redirects there after payment, and it is the allowed CORS origin
#FRONTEND_URL=https://piocart.vercel.app
#CORS_ALLOWED_ORIGINS=https://piocart.vercel.app
# First ADMIN account, created on startup if missing (password at least 8 characters)
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
# Host ports, if 5432 or 9191 are already taken on the server
#DB_PORT=5432
#APP_PORT=9191
